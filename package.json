{
  "name": "qgn",
  "productName": "QGN",
  "version": "0.1.15",
  "description": "Instant screenshot capture and screen recording tool for Windows. Clipboard-first, floating previews, annotation, multi-monitor. Open source.",
  "license": "MIT",
  "homepage": "https://qgn.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mopra/qgn.app.git"
  },
  "bugs": {
    "url": "https://github.com/Mopra/qgn.app/issues"
  },
  "author": "Mopra",
  "main": "main.js",
  "scripts": {
    "start": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawn(require('electron'), ['.'], {stdio:'inherit',detached:true}).unref(); process.exit()\"",
    "check": "node scripts/check.js",
    "smoke": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; process.exit(require('child_process').spawnSync(require('electron'), ['scripts/smoke.js'], {stdio:'inherit'}).status || 0)\"",
    "test": "npm run check && npm run smoke",
    "build": "node scripts/check.js && electron-builder --win",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.mopra.qgn",
    "productName": "QGN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "*-preload.js",
      "toast-update-renderer.js",
      "lib/**/*.js",
      "studio/**/*.js",
      "*.html",
      "icons/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QGN-Setup.${ext}",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Mopra",
      "repo": "qgn.app"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "sharp": "^0.34.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3"
  }
}
