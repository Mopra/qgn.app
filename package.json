{
  "name": "qgn",
  "productName": "QGN",
  "version": "0.1.0",
  "description": "Quick screenshot capture tool",
  "main": "main.js",
  "scripts": {
    "start": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawn(require('electron'), ['.'], {stdio:'inherit',detached:true}).unref(); process.exit()\"",
    "build": "npx @electron/packager . QGN --platform=win32 --arch=x64 --icon=icons/icon.ico --out=dist --overwrite --no-prune",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "electron": "^35.0.0",
    "electron-reloader": "^1.2.3"
  }
}
